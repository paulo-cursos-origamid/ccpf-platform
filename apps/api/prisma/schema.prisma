generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITY
// ============================================================

// Usuário global da plataforma.
// O usuário pode participar de vários Tenants através de TenantMember.
model User {
  id                         String    @id @default(uuid())
  name                       String
  email                      String    @unique
  password                   String
  role                       UserRole  @default(USER)
  isActive                   Boolean   @default(true)
  deletedAt                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  emailVerified              Boolean   @default(false)
  lastLoginAt                DateTime?
  passwordResetExpiresAt     DateTime?
  passwordResetToken         String?
  refreshTokenHash           String?
  verificationToken          String?
  verificationTokenExpiresAt DateTime?

  tenantMembers  TenantMember[]
  platformRoles  UserPlatformRole[]
  accountMembers AccountMember[]
}

enum UserRole {
  ADMIN
  USER
  MANAGER
  SUPPORT
}

// ============================================================
// TENANT
// ============================================================

// Representa o ambiente/cliente isolado dentro da plataforma SaaS.
//
// Todo dado financeiro pertencente ao cliente deverá estar
// associado ao Tenant correspondente.
model Tenant {
  id     String       @id @default(uuid())
  name   String
  slug   String       @unique
  status TenantStatus @default(ACTIVE)

  members       TenantMember[]
  accounts      Account[]
  subscriptions Subscription[]
  invoices      Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Estado operacional do Tenant.
// O status da assinatura é controlado separadamente por Subscription.
enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

// Vínculo entre um usuário e um Tenant.
//
// Um mesmo usuário pode pertencer a vários Tenants.
// O papel aqui é diferente do papel global de User
// e diferente do papel de AccountMember.
model TenantMember {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  role   TenantRole
  status TenantMemberStatus @default(ACTIVE)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TenantMemberStatus {
  ACTIVE
  INVITED
  BLOCKED
  REMOVED
}

// ============================================================
// PLANS
// ============================================================

// Plano comercial disponibilizado pela plataforma.
//
// O plano descreve o produto contratado pelo Tenant.
// Regras de acesso devem preferencialmente utilizar features,
// evitando regras espalhadas como "if plan === PREMIUM".
model Plan {
  id              String          @id @default(uuid())
  name            String
  code            String          @unique
  description     String?
  price           Decimal
  currency        String          @default("BRL")
  billingInterval BillingInterval
  maxUsers        Int
  isPublic        Boolean         @default(true)
  isActive        Boolean         @default(true)

  features      PlanFeature[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Recursos disponíveis em cada plano.
model PlanFeature {
  id      String          @id @default(uuid())
  planId  String
  feature PlanFeatureCode
  enabled Boolean         @default(true)

  plan Plan @relation(fields: [planId], references: [id])

  @@unique([planId, feature])
  @@index([planId])
}

// Features comerciais iniciais.
// Novas features podem ser adicionadas conforme os módulos
// comerciais do CCPF forem implementados.
enum PlanFeatureCode {
  DOMESTIC
  HEALTH
  TRANSPORT
  VEHICLES
  INVESTMENTS
  OTHER
  BASIC_REPORTS
  ADVANCED_REPORTS
}

// ============================================================
// SUBSCRIPTIONS
// ============================================================

// Assinatura comercial de um Tenant.
//
// Um Tenant pode possuir várias assinaturas ao longo da vida,
// permitindo histórico de planos.
// A regra de apenas uma assinatura ativa simultaneamente
// será controlada na camada de domínio/aplicação.
model Subscription {
  id       String @id @default(uuid())
  tenantId String
  planId   String

  status SubscriptionStatus @default(TRIALING)

  startedAt          DateTime
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  cancelledAt        DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([planId])
  @@index([status])
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

// ============================================================
// BILLING
// ============================================================

// Fatura comercial emitida para um Tenant.
//
// Invoice representa a cobrança do CCPF pelo uso da plataforma.
// Ela NÃO representa uma transação financeira da conta do cliente.
model Invoice {
  id             String @id @default(uuid())
  tenantId       String
  subscriptionId String

  number   String        @unique
  status   InvoiceStatus
  amount   Decimal
  currency String        @default("BRL")
  dueAt    DateTime
  paidAt   DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueAt])
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// Pagamento associado a uma Invoice.
//
// Uma Invoice pode possuir múltiplas tentativas de pagamento.
model Payment {
  id        String @id @default(uuid())
  invoiceId String

  status   PaymentStatus
  amount   Decimal
  currency String        @default("BRL")
  paidAt   DateTime?

  // Identificação abstrata do provedor.
  // A integração real com Stripe, Mercado Pago, Asaas etc.
  // será adicionada posteriormente através de uma abstração.
  provider          String?
  providerPaymentId String?

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([status])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// ============================================================
// ACCOUNTS
// ============================================================

// Conta financeira pertencente a um Tenant.
//
// A conta deixa de ser global e passa a estar isolada
// dentro de um Tenant.
model Account {
  id       String @id @default(uuid())
  tenantId String

  name           String
  type           AccountType
  currency       String
  initialBalance Decimal
  balance        Decimal

  status     AccountStatus
  archivedAt DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  accountMembers AccountMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

// Representa um vínculo entre um usuário e uma conta financeira.
//
// O acesso a uma conta é independente do papel do usuário
// dentro do Tenant.
model AccountMember {
  id        String @id @default(uuid())
  accountId String
  userId    String

  role   AccountMemberRole
  status AccountMemberStatus @default(ACTIVE)

  account Account @relation(fields: [accountId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, userId])
  @@index([accountId])
  @@index([userId])
  @@index([status])
}

// Papel do usuário especificamente dentro de uma Account.
enum AccountMemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

// Define se o vínculo do usuário com a conta está ativo ou bloqueado.
//
// O bloqueio é específico da conta e não desativa o usuário globalmente.
enum AccountMemberStatus {
  ACTIVE
  BLOCKED
}

enum AccountType {
  CASH
  CHECKING
  SAVINGS
  DIGITAL
  INVESTMENT
  OTHER
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

// Representa um papel global do usuário dentro da plataforma CCPF.
// Diferente de TenantRole, este papel não depende de um Tenant específico.
model PlatformRole {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)

  permissions PlatformRolePermission[]
  users       UserPlatformRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Representa uma permissão global disponível na plataforma.
// As permissões são mantidas como registros para permitir evolução
// do sistema sem transformar cada nova permissão em uma migration.
model PlatformPermission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  roles PlatformRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Relacionamento N:N entre PlatformRole e PlatformPermission.
// Um papel pode possuir várias permissões e uma permissão pode
// pertencer a vários papéis.
model PlatformRolePermission {
  roleId       String
  permissionId String

  role       PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// Relacionamento N:N entre User e PlatformRole.
// Um usuário pode possuir vários papéis globais simultaneamente.
model UserPlatformRole {
  userId String
  roleId String

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}
