enum NotificationType {
  ACCOUNT_CREATED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_CHANGED
  TENANT_CREATED
  TENANT_SUSPENDED
  USER_BLOCKED
  USER_REMOVED
  SYSTEM
  PAYMENT_CANCELLED
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITY
// ============================================================

// Usuário global da plataforma.
// O usuário pode participar de vários Tenants através de TenantMember.
model User {
  id                         String    @id @default(uuid())
  name                       String
  email                      String    @unique
  password                   String
  role                       UserRole  @default(USER)
  isActive                   Boolean   @default(true)
  deletedAt                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  emailVerified              Boolean   @default(false)
  lastLoginAt                DateTime?
  passwordResetExpiresAt     DateTime?
  passwordResetToken         String?
  refreshTokenHash           String?
  verificationToken          String?
  verificationTokenExpiresAt DateTime?

  tenantMembers  TenantMember[]
  platformRoles  UserPlatformRole[]
  accountMembers AccountMember[]
  notifications  Notification[]
  billingAccount BillingAccount?
}

enum UserRole {
  ADMIN
  USER
  MANAGER
  SUPPORT
}

// ============================================================
// TENANT
// ============================================================

// Representa o ambiente/cliente isolado dentro da plataforma SaaS.
//
// Todo dado financeiro pertencente ao cliente deverá estar
// associado ao Tenant correspondente.
model Tenant {
  id            String       @id @default(uuid())
  name          String
  slug          String       @unique
  status        TenantStatus @default(ACTIVE)
  nameConfirmed Boolean      @default(true)

  members       TenantMember[]
  accounts      Account[]
  categories    Category[]
  subscriptions Subscription[]
  invoices      Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  billingAccountId String?
  billingAccount   BillingAccount? @relation(fields: [billingAccountId], references: [id])
  @@index([billingAccountId])
}

// Estado operacional do Tenant.
// O status da assinatura é controlado separadamente por Subscription.
enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

// Vínculo entre um usuário e um Tenant.
//
// Um mesmo usuário pode pertencer a vários Tenants.
// O papel aqui é diferente do papel global de User
// e diferente do papel de AccountMember.
model TenantMember {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  role   TenantRole
  status TenantMemberStatus @default(ACTIVE)
  origin TenantMemberOrigin @default(EXISTING_USER)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
}

enum TenantMemberOrigin {
  EXISTING_USER
  TENANT_CREATED
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TenantMemberStatus {
  ACTIVE
  INVITED
  BLOCKED
  REMOVED
}

// ============================================================
// PLANS
// ============================================================

// Plano comercial disponibilizado pela plataforma.
//
// O plano descreve o produto contratado pelo Tenant.
// Regras de acesso devem preferencialmente utilizar features,
// evitando regras espalhadas como "if plan === PREMIUM".
model Plan {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?
  maxUsers    Int
  maxTenants  Int     @default(1)
  isPublic    Boolean @default(true)
  isActive    Boolean @default(true)

  features      PlanFeature[]
  prices        PlanPrice[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modalidade comercial de um plano.
//
// O produto é representado por Plan.
// O preço e a periodicidade são representados por PlanPrice.
model PlanPrice {
  id       String          @id @default(uuid())
  planId   String
  interval BillingInterval
  amount   Decimal
  currency String          @default("BRL")
  isActive Boolean         @default(true)

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, interval])
  @@index([planId])
  @@index([interval])
  @@index([isActive])
}

// Recursos disponíveis em cada plano.
model PlanFeature {
  id      String          @id @default(uuid())
  planId  String
  feature PlanFeatureCode
  enabled Boolean         @default(true)

  plan Plan @relation(fields: [planId], references: [id])

  @@unique([planId, feature])
  @@index([planId])
}

// Features comerciais iniciais.
// Novas features podem ser adicionadas conforme os módulos
// comerciais do CCPF forem implementados.
enum PlanFeatureCode {
  DOMESTIC
  HEALTH
  TRANSPORT
  VEHICLES
  INVESTMENTS
  OTHER
  BASIC_REPORTS
  ADVANCED_REPORTS
}

// ============================================================
// SUBSCRIPTIONS
// ============================================================

// Assinatura comercial de um Tenant.
//
// Um Tenant pode possuir várias assinaturas ao longo da vida,
// permitindo histórico de planos.
// A regra de apenas uma assinatura ativa simultaneamente
// será controlada na camada de domínio/aplicação.
model Subscription {
  id          String  @id @default(uuid())
  tenantId    String
  planId      String
  planPriceId String?

  // Alteração comercial pendente.
  // planId/planPriceId continuam representando a modalidade efetiva.
  pendingPlanId          String?
  pendingPlanPriceId     String?
  pendingPlanChangeType  SubscriptionPlanChangeType?
  pendingPlanEffectiveAt DateTime?
  pendingPlanInvoiceId   String?

  // Dia de cobrança escolhido para a modalidade pendente.
  // Lifetime permanece nulo.
  pendingBillingDay Int?

  status SubscriptionStatus @default(TRIALING)

  startedAt          DateTime
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  // Dia preferencial de cobrança para assinaturas recorrentes.
  // Valores válidos: 1..31.
  // Lifetime e Trial podem permanecer nulos.
  billingDay Int?

  // Próxima cobrança de uma assinatura recorrente.
  // Lifetime não possui próxima cobrança.
  nextBillingDate DateTime?

  trialEndsAt DateTime?
  cancelledAt DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  plan      Plan       @relation(fields: [planId], references: [id])
  planPrice PlanPrice? @relation(fields: [planPriceId], references: [id])

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([planId])
  @@index([planPriceId])
  @@index([status])
  @@index([billingDay])
  @@index([pendingBillingDay])
  @@index([nextBillingDate])
  @@index([pendingPlanId])
  @@index([pendingPlanPriceId])
  @@index([pendingPlanEffectiveAt])
  @@index([pendingPlanInvoiceId])
  billingAccountId String?
  billingAccount   BillingAccount? @relation(fields: [billingAccountId], references: [id])
  @@index([billingAccountId])
}

enum SubscriptionPlanChangeType {
  UPGRADE
  DOWNGRADE
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  SEMESTERLY
  YEARLY
  LIFETIME
}

// Meio de pagamento aceito pelo CCPF.
// O domínio começa com PIX e BOLETO e pode receber novos meios
// futuramente sem depender de um provedor específico.
enum PaymentMethod {
  PIX
  BANK_SLIP
}

// ============================================================
// BILLING
// ============================================================

// Fatura comercial emitida para um Tenant.
//
// Invoice representa a cobrança do CCPF pelo uso da plataforma.
// Ela NÃO representa uma transação financeira da conta do cliente.
model Invoice {
  id             String @id @default(uuid())
  tenantId       String
  subscriptionId String

  number           String        @unique
  status           InvoiceStatus
  installmentCount Int           @default(1)
  amount           Decimal
  currency         String        @default("BRL")
  dueAt            DateTime
  paidAt           DateTime?

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  subscription Subscription         @relation(fields: [subscriptionId], references: [id])
  installments InvoiceInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueAt])
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceInstallmentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceInstallment {
  id         String                   @id @default(uuid())
  invoiceId  String
  number     Int
  totalCount Int
  amount     Decimal
  currency   String                   @default("BRL")
  dueAt      DateTime
  paidAt     DateTime?
  status     InvoiceInstallmentStatus @default(PENDING)

  invoice  Invoice   @relation(fields: [invoiceId], references: [id])
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([invoiceId, number])
  @@index([invoiceId])
  @@index([status])
  @@index([dueAt])
}

// Tentativa de pagamento associada a uma parcela de uma Invoice.
//
// Uma parcela pode possuir múltiplas tentativas de pagamento.
model Payment {
  id            String @id @default(uuid())
  installmentId String

  // Referência interna única da tentativa de pagamento.
  // É usada para conciliação manual e poderá ser associada
  // posteriormente ao identificador externo de um gateway.
  reference String @unique

  // Meio de pagamento utilizado na tentativa.
  method PaymentMethod

  status   PaymentStatus
  cancellationReason String?
  amount   Decimal
  currency String        @default("BRL")
  paidAt   DateTime?

  // Data limite para pagamento ou expiração da tentativa.
  expiresAt DateTime?

  // Identificação abstrata do provedor.
  //
  // Durante a operação manual poderá ser "MANUAL".
  // Futuramente poderá receber o código de um gateway.
  provider          String?
  providerPaymentId String?

  // Identificador externo da cobrança.
  //
  // Exemplos futuros:
  // - txid de uma cobrança PIX;
  // - identificador externo do boleto;
  // - identificador equivalente fornecido pelo gateway.
  externalReference String?

  // Dados necessários para cobrança PIX manual.
  //
  // O payload de copia e cola pode ser armazenado aqui.
  // O QR Code pode ser gerado/apresentado pela camada de apresentação
  // a partir do payload ou persistido separadamente futuramente.
  pixCopyPaste String?

  // Dados necessários para boleto manual.
  bankSlipBarcode       String? @map("boletoBarcode")
  bankSlipDigitableLine String? @map("boletoDigitableLine")

  // Dados adicionais específicos de um provedor.
  //
  // Mantém o domínio preparado para campos que surjam em futuras
  // integrações sem amarrar o schema a um fornecedor.
  metadata Json?

  installment InvoiceInstallment @relation(fields: [installmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([installmentId])
  @@index([status])
  @@index([method])
  @@index([provider, providerPaymentId])
  @@index([externalReference])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// ============================================================
// ACCOUNTS
// ============================================================

// Conta financeira pertencente a um Tenant.
//
// A conta deixa de ser global e passa a estar isolada
// dentro de um Tenant.
model Account {
  id       String @id @default(uuid())
  tenantId String

  name           String
  type           AccountType
  currency       String
  initialBalance Decimal
  balance        Decimal

  status     AccountStatus
  archivedAt DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  accountMembers AccountMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
}

// Representa um vínculo entre um usuário e uma conta financeira.
//
// O acesso a uma conta é independente do papel do usuário
// dentro do Tenant.
model AccountMember {
  id        String @id @default(uuid())
  accountId String
  userId    String

  role   AccountMemberRole
  status AccountMemberStatus @default(ACTIVE)

  account Account @relation(fields: [accountId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, userId])
  @@index([accountId])
  @@index([userId])
  @@index([status])
}

// Papel do usuário especificamente dentro de uma Account.
enum AccountMemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

// Define se o vínculo do usuário com a conta está ativo ou bloqueado.
//
// O bloqueio é específico da conta e não desativa o usuário globalmente.
enum AccountMemberStatus {
  ACTIVE
  BLOCKED
}

enum AccountType {
  CASH
  CHECKING
  SAVINGS
  DIGITAL
  INVESTMENT
  OTHER
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

// Representa um papel global do usuário dentro da plataforma CCPF.
// Diferente de TenantRole, este papel não depende de um Tenant específico.
model PlatformRole {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)

  permissions PlatformRolePermission[]
  users       UserPlatformRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Representa uma permissão global disponível na plataforma.
// As permissões são mantidas como registros para permitir evolução
// do sistema sem transformar cada nova permissão em uma migration.
model PlatformPermission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  roles PlatformRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Relacionamento N:N entre PlatformRole e PlatformPermission.
// Um papel pode possuir várias permissões e uma permissão pode
// pertencer a vários papéis.
model PlatformRolePermission {
  roleId       String
  permissionId String

  role       PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// Relacionamento N:N entre User e PlatformRole.
// Um usuário pode possuir vários papéis globais simultaneamente.
model UserPlatformRole {
  userId String
  roleId String

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Notification {
  id               String               @id @default(uuid())
  userId           String
  type             NotificationType
  severity         NotificationSeverity
  title            String
  message          String
  resourceType     String?
  resourceId       String?
  deduplicationKey String?
  readAt           DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deduplicationKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, type])
  @@index([resourceType, resourceId])
}
// ============================================================
// CATEGORIES
// ============================================================

// Categoria financeira pertencente a um Tenant.
// A hierarquia parent/children permite categorias aninhadas.
// A exclusão lógica preserva a possibilidade de manter histórico.
model CategoryTemplate {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  type              CategoryType
  description       String?
  color             String?
  icon              String?
  isVehicleCategory Boolean  @default(false)

  subCategories SubCategoryTemplate[]
  domains       CategoryTemplateDomain[]
  categories    Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model SubCategoryTemplate {
  id                String   @id @default(uuid())
  categoryTemplateId String
  name              String
  slug              String
  description       String?
  color             String?
  icon              String?

  categoryTemplate CategoryTemplate @relation(fields: [categoryTemplateId], references: [id], onDelete: Cascade)
  categories       SubCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryTemplateId, slug])
  @@index([categoryTemplateId])
}

model CategoryTemplateDomain {
  templateId String
  domain     CategoryDomain

  template CategoryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, domain])
  @@index([domain])
}

model CategoryDomainLink {
  categoryId String
  domain     CategoryDomain

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, domain])
  @@index([domain])
}

model Category {
  id                String       @id @default(uuid())
  tenantId          String
  templateId        String?
  name              String
  slug              String
  type              CategoryType
  description       String?
  color             String?
  icon              String?
  isVehicleCategory Boolean      @default(false)
  parentId          String?
  deletedAt         DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  template     CategoryTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  domains      CategoryDomainLink[]
  parent       Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]   @relation("CategoryHierarchy")
  subCategories SubCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([templateId])
  @@index([tenantId, type])
  @@index([parentId])
  @@index([deletedAt])
}

// Subcategoria vinculada a uma categoria.
// O tenant é obtido pela categoria proprietária e deverá ser
// validado pela aplicação em todas as operações por identificador.
model SubCategory {
  id          String    @id @default(uuid())
  categoryId  String
  templateId  String?
  name        String
  slug        String
  description String?
  color       String?
  icon        String?
  deletedAt   DateTime?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  template  SubCategoryTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([templateId])
  @@index([deletedAt])
}

enum CategoryDomain {
  DOMESTIC
  HEALTH
  TRANSPORT
  VEHICLES
  INVESTMENTS
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}


model BillingAccount {
  id        String   @id @default(uuid())
  name      String
  ownerUserId String @unique

  owner         User           @relation(fields: [ownerUserId], references: [id])
  tenants       Tenant[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
}
