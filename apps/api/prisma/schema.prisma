enum NotificationType {
  ACCOUNT_CREATED
  PAYMENT_PENDING
  PAYMENT_CONFIRMED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_CHANGED
  TENANT_CREATED
  TENANT_SUSPENDED
  USER_BLOCKED
  USER_REMOVED
  SYSTEM
  PAYMENT_CANCELLED
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITY
// ============================================================

// Usuário global da plataforma.
// O usuário pode participar de vários Tenants através de TenantMember.
model User {
  id                         String    @id @default(uuid())
  name                       String
  email                      String    @unique
  password                   String
  role                       UserRole  @default(USER)
  isActive                   Boolean   @default(true)
  deletedAt                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  emailVerified              Boolean   @default(false)
  lastLoginAt                DateTime?
  passwordResetExpiresAt     DateTime?
  passwordResetToken         String?
  refreshTokenHash           String?
  verificationToken          String?
  verificationTokenExpiresAt DateTime?

  tenantMembers  TenantMember[]
  platformRoles  UserPlatformRole[]
  accountMembers AccountMember[]
  notifications  Notification[]
  billingAccount BillingAccount?

  transactions     Transaction[]
  transfers        Transfer[]
  ledgerEntries    LedgerEntry[]
  installmentPlans InstallmentPlan[]

  recurringBills RecurringBill[]
}

enum UserRole {
  ADMIN
  USER
  MANAGER
  SUPPORT
}

// ============================================================
// TENANT
// ============================================================

// Representa o ambiente/cliente isolado dentro da plataforma SaaS.
//
// Todo dado financeiro pertencente ao cliente deverá estar
// associado ao Tenant correspondente.
model Tenant {
  id            String       @id @default(uuid())
  name          String
  slug          String       @unique
  status        TenantStatus @default(ACTIVE)
  nameConfirmed Boolean      @default(true)

  members       TenantMember[]
  accounts      Account[]
  categories    Category[]
  subscriptions Subscription[]
  invoices      Invoice[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  billingAccountId String?
  billingAccount   BillingAccount? @relation(fields: [billingAccountId], references: [id])

  transactions     Transaction[]
  transfers        Transfer[]
  ledgerEntries    LedgerEntry[]
  installmentPlans InstallmentPlan[]
  installments     Installment[]

  @@index([billingAccountId])

  recurringBills RecurringBill[]
  recurringBillOccurrences RecurringBillOccurrence[]
}

// Estado operacional do Tenant.
// O status da assinatura é controlado separadamente por Subscription.
enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

// Vínculo entre um usuário e um Tenant.
//
// Um mesmo usuário pode pertencer a vários Tenants.
// O papel aqui é diferente do papel global de User
// e diferente do papel de AccountMember.
model TenantMember {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  role   TenantRole
  status TenantMemberStatus @default(ACTIVE)
  origin TenantMemberOrigin @default(EXISTING_USER)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@index([status])
}

enum TenantMemberOrigin {
  EXISTING_USER
  TENANT_CREATED
}

enum TenantRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TenantMemberStatus {
  ACTIVE
  INVITED
  BLOCKED
  REMOVED
}

// ============================================================
// PLANS
// ============================================================

// Plano comercial disponibilizado pela plataforma.
//
// O plano descreve o produto contratado pelo Tenant.
// Regras de acesso devem preferencialmente utilizar features,
// evitando regras espalhadas como "if plan === PREMIUM".
model Plan {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  description String?
  maxUsers    Int
  maxTenants  Int     @default(1)
  isPublic    Boolean @default(true)
  isActive    Boolean @default(true)

  features      PlanFeature[]
  prices        PlanPrice[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Modalidade comercial de um plano.
//
// O produto é representado por Plan.
// O preço e a periodicidade são representados por PlanPrice.
model PlanPrice {
  id       String          @id @default(uuid())
  planId   String
  interval BillingInterval
  amount   Decimal
  currency String          @default("BRL")
  isActive Boolean         @default(true)

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, interval])
  @@index([planId])
  @@index([interval])
  @@index([isActive])
}

// Recursos disponíveis em cada plano.
model PlanFeature {
  id      String          @id @default(uuid())
  planId  String
  feature PlanFeatureCode
  enabled Boolean         @default(true)

  plan Plan @relation(fields: [planId], references: [id])

  @@unique([planId, feature])
  @@index([planId])
}

// Features comerciais iniciais.
// Novas features podem ser adicionadas conforme os módulos
// comerciais do CCPF forem implementados.
enum PlanFeatureCode {
  DOMESTIC
  HEALTH
  TRANSPORT
  VEHICLES
  INVESTMENTS
  OTHER
  BASIC_REPORTS
  ADVANCED_REPORTS
}

// ============================================================
// SUBSCRIPTIONS
// ============================================================

// Assinatura comercial de um Tenant.
//
// Um Tenant pode possuir várias assinaturas ao longo da vida,
// permitindo histórico de planos.
// A regra de apenas uma assinatura ativa simultaneamente
// será controlada na camada de domínio/aplicação.
model Subscription {
  id          String  @id @default(uuid())
  tenantId    String
  planId      String
  planPriceId String?

  // Alteração comercial pendente.
  // planId/planPriceId continuam representando a modalidade efetiva.
  pendingPlanId          String?
  pendingPlanPriceId     String?
  pendingPlanChangeType  SubscriptionPlanChangeType?
  pendingPlanEffectiveAt DateTime?
  pendingPlanInvoiceId   String?

  // Dia de cobrança escolhido para a modalidade pendente.
  // Lifetime permanece nulo.
  pendingBillingDay Int?

  status SubscriptionStatus @default(TRIALING)

  startedAt          DateTime
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  // Dia preferencial de cobrança para assinaturas recorrentes.
  // Valores válidos: 1..31.
  // Lifetime e Trial podem permanecer nulos.
  billingDay Int?

  // Próxima cobrança de uma assinatura recorrente.
  // Lifetime não possui próxima cobrança.
  nextBillingDate DateTime?

  trialEndsAt DateTime?
  cancelledAt DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  plan      Plan       @relation(fields: [planId], references: [id])
  planPrice PlanPrice? @relation(fields: [planPriceId], references: [id])

  invoices Invoice[]

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  billingAccountId String?
  billingAccount   BillingAccount? @relation(fields: [billingAccountId], references: [id])

  @@index([tenantId])
  @@index([planId])
  @@index([planPriceId])
  @@index([status])
  @@index([billingDay])
  @@index([pendingBillingDay])
  @@index([nextBillingDate])
  @@index([pendingPlanId])
  @@index([pendingPlanPriceId])
  @@index([pendingPlanEffectiveAt])
  @@index([pendingPlanInvoiceId])
  @@index([billingAccountId])
}

enum SubscriptionPlanChangeType {
  UPGRADE
  DOWNGRADE
}

enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  SEMESTERLY
  YEARLY
  LIFETIME
}

// Meio de pagamento aceito pelo CCPF.
// O domínio começa com PIX e BOLETO e pode receber novos meios
// futuramente sem depender de um provedor específico.
enum PaymentMethod {
  PIX
  BANK_SLIP
}

// ============================================================
// BILLING
// ============================================================

// Fatura comercial emitida para um Tenant.
//
// Invoice representa a cobrança do CCPF pelo uso da plataforma.
// Ela NÃO representa uma transação financeira da conta do cliente.
model Invoice {
  id             String @id @default(uuid())
  tenantId       String
  subscriptionId String

  number           String        @unique
  status           InvoiceStatus
  installmentCount Int           @default(1)
  amount           Decimal
  currency         String        @default("BRL")
  dueAt            DateTime
  paidAt           DateTime?

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  subscription Subscription         @relation(fields: [subscriptionId], references: [id])
  installments InvoiceInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueAt])
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceInstallmentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model InvoiceInstallment {
  id         String                   @id @default(uuid())
  invoiceId  String
  number     Int
  totalCount Int
  amount     Decimal
  currency   String                   @default("BRL")
  dueAt      DateTime
  paidAt     DateTime?
  status     InvoiceInstallmentStatus @default(PENDING)

  invoice  Invoice   @relation(fields: [invoiceId], references: [id])
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([invoiceId, number])
  @@index([invoiceId])
  @@index([status])
  @@index([dueAt])
}

// Tentativa de pagamento associada a uma parcela de uma Invoice.
//
// Uma parcela pode possuir múltiplas tentativas de pagamento.
model Payment {
  id            String @id @default(uuid())
  installmentId String

  // Referência interna única da tentativa de pagamento.
  // É usada para conciliação manual e poderá ser associada
  // posteriormente ao identificador externo de um gateway.
  reference String @unique

  // Meio de pagamento utilizado na tentativa.
  method PaymentMethod

  status             PaymentStatus
  cancellationReason String?
  amount             Decimal
  currency           String        @default("BRL")
  paidAt             DateTime?

  // Data limite para pagamento ou expiração da tentativa.
  expiresAt DateTime?

  // Identificação abstrata do provedor.
  //
  // Durante a operação manual poderá ser "MANUAL".
  // Futuramente poderá receber o código de um gateway.
  provider          String?
  providerPaymentId String?

  // Identificador externo da cobrança.
  //
  // Exemplos futuros:
  // - txid de uma cobrança PIX;
  // - identificador externo do boleto;
  // - identificador equivalente fornecido pelo gateway.
  externalReference String?

  // Dados necessários para cobrança PIX manual.
  //
  // O payload de copia e cola pode ser armazenado aqui.
  // O QR Code pode ser gerado/apresentado pela camada de apresentação
  // a partir do payload ou persistido separadamente futuramente.
  pixCopyPaste String?

  // Dados necessários para boleto manual.
  bankSlipBarcode       String? @map("boletoBarcode")
  bankSlipDigitableLine String? @map("boletoDigitableLine")

  // Dados adicionais específicos de um provedor.
  //
  // Mantém o domínio preparado para campos que surjam em futuras
  // integrações sem amarrar o schema a um fornecedor.
  metadata Json?

  installment InvoiceInstallment @relation(fields: [installmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([installmentId])
  @@index([status])
  @@index([method])
  @@index([provider, providerPaymentId])
  @@index([externalReference])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

// ============================================================
// ACCOUNTS
// ============================================================

// Conta financeira pertencente a um Tenant.
//
// A conta deixa de ser global e passa a estar isolada
// dentro de um Tenant.
model Account {
  id       String @id @default(uuid())
  tenantId String

  name           String
  type           AccountType
  currency       String
  initialBalance Decimal
  balance        Decimal

  status     AccountStatus
  archivedAt DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  accountMembers AccountMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions      Transaction[]
  sentTransfers     Transfer[]        @relation("TransferFromAccount")
  receivedTransfers Transfer[]        @relation("TransferToAccount")
  ledgerEntries     LedgerEntry[]
  installmentPlans  InstallmentPlan[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([status])

  recurringBills RecurringBill[]
}

// Representa um vínculo entre um usuário e uma conta financeira.
//
// O acesso a uma conta é independente do papel do usuário
// dentro do Tenant.
model AccountMember {
  id        String @id @default(uuid())
  accountId String
  userId    String

  role   AccountMemberRole
  status AccountMemberStatus @default(ACTIVE)

  account Account @relation(fields: [accountId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, userId])
  @@index([accountId])
  @@index([userId])
  @@index([status])
}

// Papel do usuário especificamente dentro de uma Account.
enum AccountMemberRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

// Define se o vínculo do usuário com a conta está ativo ou bloqueado.
//
// O bloqueio é específico da conta e não desativa o usuário globalmente.
enum AccountMemberStatus {
  ACTIVE
  BLOCKED
}

enum AccountType {
  CASH
  CHECKING
  SAVINGS
  DIGITAL
  INVESTMENT
  OTHER
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

// Representa um papel global do usuário dentro da plataforma CCPF.
// Diferente de TenantRole, este papel não depende de um Tenant específico.
model PlatformRole {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)

  permissions PlatformRolePermission[]
  users       UserPlatformRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Representa uma permissão global disponível na plataforma.
// As permissões são mantidas como registros para permitir evolução
// do sistema sem transformar cada nova permissão em uma migration.
model PlatformPermission {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  roles PlatformRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Relacionamento N:N entre PlatformRole e PlatformPermission.
// Um papel pode possuir várias permissões e uma permissão pode
// pertencer a vários papéis.
model PlatformRolePermission {
  roleId       String
  permissionId String

  role       PlatformRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PlatformPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

// Relacionamento N:N entre User e PlatformRole.
// Um usuário pode possuir vários papéis globais simultaneamente.
model UserPlatformRole {
  userId String
  roleId String

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role PlatformRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Notification {
  id               String               @id @default(uuid())
  userId           String
  type             NotificationType
  severity         NotificationSeverity
  title            String
  message          String
  resourceType     String?
  resourceId       String?
  deduplicationKey String?
  readAt           DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deduplicationKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, type])
  @@index([resourceType, resourceId])
}

// ============================================================
// CATEGORIES
// ============================================================

// Categoria financeira pertencente a um Tenant.
// A hierarquia parent/children permite categorias aninhadas.
// A exclusão lógica preserva a possibilidade de manter histórico.
model CategoryTemplate {
  id                String       @id @default(uuid())
  name              String
  slug              String       @unique
  type              CategoryType
  description       String?
  color             String?
  icon              String?
  isVehicleCategory Boolean      @default(false)

  subCategories SubCategoryTemplate[]
  domains       CategoryTemplateDomain[]
  categories    Category[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model SubCategoryTemplate {
  id                 String  @id @default(uuid())
  categoryTemplateId String
  name               String
  slug               String
  description        String?
  color              String?
  icon               String?

  categoryTemplate CategoryTemplate @relation(fields: [categoryTemplateId], references: [id], onDelete: Cascade)
  categories       SubCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryTemplateId, slug])
  @@index([categoryTemplateId])
}

model CategoryTemplateDomain {
  templateId String
  domain     CategoryDomain

  template CategoryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, domain])
  @@index([domain])
}

model CategoryDomainLink {
  categoryId String
  domain     CategoryDomain

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, domain])
  @@index([domain])
}

model Category {
  id                   String       @id @default(uuid())
  tenantId             String
  templateId           String?
  name                 String
  slug                 String
  type                 CategoryType
  description          String?
  color                String?
  icon                 String?
  isVehicleCategory    Boolean      @default(false)
  isDomesticCategory   Boolean      @default(false)
  isHealthCategory     Boolean      @default(false)
  isTransportCategory  Boolean      @default(false)
  isInvestmentCategory Boolean      @default(false)
  isOtherCategory      Boolean      @default(false)
  parentId             String?
  deletedAt            DateTime?

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  template      CategoryTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  domains       CategoryDomainLink[]
  parent        Category?            @relation("CategoryHierarchy", fields: [parentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  children      Category[]           @relation("CategoryHierarchy")
  subCategories SubCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions     Transaction[]
  installmentPlans InstallmentPlan[]

  @@unique([tenantId, slug])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([templateId])
  @@index([tenantId, type])
  @@index([parentId])
  @@index([deletedAt])

  recurringBills RecurringBill[]
}

// Subcategoria vinculada a uma categoria.
// O tenant é obtido pela categoria proprietária e deverá ser
// validado pela aplicação em todas as operações por identificador.
model SubCategory {
  id          String    @id @default(uuid())
  categoryId  String
  templateId  String?
  name        String
  slug        String
  description String?
  color       String?
  icon        String?
  deletedAt   DateTime?

  category Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  template SubCategoryTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions     Transaction[]
  installmentPlans InstallmentPlan[]

  @@unique([categoryId, slug])
  @@unique([id, categoryId])
  @@index([categoryId])
  @@index([templateId])
  @@index([deletedAt])

  recurringBills RecurringBill[]
}

enum CategoryDomain {
  DOMESTIC
  HEALTH
  TRANSPORT
  VEHICLES
  INVESTMENTS
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

model BillingAccount {
  id          String @id @default(uuid())
  name        String
  ownerUserId String @unique

  owner         User           @relation(fields: [ownerUserId], references: [id])
  tenants       Tenant[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
}

// ============================================================
// DOMÍNIO FINANCEIRO — TIPOS E MOVIMENTAÇÕES
// ============================================================

// Natureza da movimentação financeira.
// INCOME representa uma entrada de dinheiro.
// EXPENSE representa uma saída de dinheiro.
enum TransactionType {
  INCOME
  EXPENSE
}

// Natureza do lançamento no livro-razão.
// CREDIT registra um crédito na conta.
// DEBIT registra um débito na conta.
enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

// Tipo de operação que originou um lançamento contábil.
// Permite rastrear a origem e realizar estornos auditáveis.
enum LedgerReferenceType {
  TRANSACTION
  TRANSFER
  ADJUSTMENT
  REVERSAL
}

// ============================================================
// TRANSAÇÕES FINANCEIRAS
// ============================================================

// Registra receitas e despesas de um Espaço.
// A transação deve pertencer ao mesmo Espaço da conta,
// categoria e subcategoria utilizadas.
// O valor é armazenado como Decimal para evitar imprecisão monetária.
// A exclusão é lógica, preservando o histórico financeiro.
model Transaction {
  id            String          @id @default(cuid())
  tenantId      String
  userId        String
  accountId     String
  categoryId    String
  subCategoryId String?
  title         String
  amount        Decimal         @db.Decimal(12, 2)
  type          TransactionType
  date          DateTime
  description   String?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relações com o Espaço, usuário e classificadores financeiros.
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  account     Account      @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  category    Category     @relation(fields: [categoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  subCategory SubCategory? @relation(fields: [subCategoryId, categoryId], references: [id, categoryId], onDelete: Restrict)

  // Índices priorizam consultas isoladas por Espaço.
  @@index([tenantId, date])
  @@index([tenantId, accountId, date])
  @@index([tenantId, categoryId, date])
  @@index([tenantId, type, date])
  @@index([tenantId, deletedAt])

  recurringBillOccurrences RecurringBillOccurrence[]
  installments Installment[]
}

// Planejamento de uma compra parcelada. Não movimenta saldo nem ledger.
model InstallmentPlan {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String
  accountId        String
  categoryId       String
  subCategoryId    String?
  title            String
  totalAmount      Decimal   @db.Decimal(12, 2)
  purchaseDate     DateTime
  installmentCount Int
  firstDueDate     DateTime
  description      String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  account      Account       @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  category     Category      @relation(fields: [categoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  subCategory  SubCategory?  @relation(fields: [subCategoryId, categoryId], references: [id, categoryId], onDelete: Restrict)
  installments Installment[]

  @@unique([id, tenantId])
  @@index([tenantId, purchaseDate])
  @@index([tenantId, accountId])
  @@index([tenantId, deletedAt])
}

// Parcela planejada. Só a futura efetivação poderá gerar movimentação financeira.
model Installment {
  id                String            @id @default(cuid())
  tenantId          String
  installmentPlanId String
  transactionId     String? @unique
  installmentNumber Int
  amount            Decimal           @db.Decimal(12, 2)
  dueDate           DateTime
  status            InstallmentStatus @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   InstallmentPlan @relation(fields: [installmentPlanId, tenantId], references: [id, tenantId], onDelete: Restrict)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([installmentPlanId, installmentNumber])
  @@index([tenantId, dueDate, status])
  @@index([tenantId, installmentPlanId])
}

// ============================================================
// TRANSFERÊNCIAS ENTRE CONTAS
// ============================================================

// Registra a transferência de valores entre duas contas
// pertencentes ao mesmo Espaço.
// A operação deve ser atômica: débito na origem e crédito no destino.
// A conta de origem e a conta de destino devem ser diferentes.
// Os lançamentos correspondentes devem manter referência à transferência.
model Transfer {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String
  fromAccountId String
  toAccountId   String
  amount        Decimal   @db.Decimal(12, 2)
  description   String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  user        User    @relation(fields: [userId], references: [id])
  fromAccount Account @relation("TransferFromAccount", fields: [fromAccountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  toAccount   Account @relation("TransferToAccount", fields: [toAccountId, tenantId], references: [id, tenantId], onDelete: Restrict)

  // Índices para histórico de transferências por Espaço e conta.
  @@index([tenantId, createdAt])
  @@index([tenantId, fromAccountId, createdAt])
  @@index([tenantId, toAccountId, createdAt])
  @@index([tenantId, deletedAt])
}

// ============================================================
// LIVRO-RAZÃO FINANCEIRO (LEDGER)
// ============================================================

// Registra os efeitos financeiros das operações sobre as contas.
// Lançamentos contabilizados não devem ser apagados para corrigir erros;
// deve ser criado um lançamento de estorno vinculado ao original.
// referenceId e referenceType identificam a operação de origem.
// A validação da consistência entre Espaço, conta e referência
// deve ocorrer na camada de aplicação e, quando possível, no banco.
model LedgerEntry {
  id            String              @id @default(cuid())
  tenantId      String
  userId        String
  accountId     String
  type          LedgerEntryType
  amount        Decimal             @db.Decimal(12, 2)
  description   String?
  referenceId   String
  referenceType LedgerReferenceType
  createdAt     DateTime            @default(now())
  reversedAt    DateTime?
  reversalOfId  String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  account Account @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)

  // Relação autorreferente para preservar o vínculo de estorno.
  reversalOf LedgerEntry?  @relation("LedgerReversal", fields: [reversalOfId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reversals  LedgerEntry[] @relation("LedgerReversal")

  @@unique([id, tenantId])
  @@unique([tenantId, accountId, referenceType, referenceId, type], map: "LedgerEntry_operation_account_type_key")
  @@unique([reversalOfId], map: "LedgerEntry_reversalOfId_key")
  // Índices para extrato, rastreabilidade e auditoria por Espaço.
  @@index([tenantId, accountId, createdAt])
  @@index([tenantId, referenceType, referenceId])
  @@index([tenantId, reversalOfId])
}


// ============================================================
// CONTAS RECORRENTES
// ============================================================

enum RecurringBillFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum RecurringBillOccurrenceStatus {
  PENDING
  PAID
  CANCELED
}

model RecurringBill {
  id             String @id @default(cuid())
  tenantId       String
  userId         String
  accountId      String
  categoryId     String
  subCategoryId  String?

  title          String
  expectedAmount Decimal? @db.Decimal(12, 2)
  frequency      RecurringBillFrequency @default(MONTHLY)
  dueDay         Int
  startDate      DateTime
  endDate        DateTime?
  description    String?
  isActive       Boolean @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant @relation(fields: [tenantId], references: [id])
  user           User @relation(fields: [userId], references: [id])
  account        Account @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  category       Category @relation(fields: [categoryId, tenantId], references: [id, tenantId], onDelete: Restrict)
  subCategory    SubCategory? @relation(fields: [subCategoryId, categoryId], references: [id, categoryId], onDelete: Restrict)

  occurrences    RecurringBillOccurrence[]

  @@unique([id, tenantId])
  @@index([tenantId, accountId])
  @@index([tenantId, isActive])
  @@index([tenantId, dueDay])
}

model RecurringBillOccurrence {
  id              String @id @default(cuid())
  tenantId        String
  recurringBillId String
  transactionId   String? @unique

  referenceMonth  DateTime
  dueDate         DateTime
  expectedAmount  Decimal? @db.Decimal(12, 2)
  paidAmount      Decimal? @db.Decimal(12, 2)
  paidAt          DateTime?
  status          RecurringBillOccurrenceStatus @default(PENDING)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant @relation(fields: [tenantId], references: [id])
  recurringBill   RecurringBill @relation(fields: [recurringBillId, tenantId], references: [id, tenantId], onDelete: Restrict)
  transaction     Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([recurringBillId, referenceMonth])
  @@index([tenantId, dueDate, status])
  @@index([tenantId, recurringBillId])
}
